import java.util.*;
public class twoSum{
  public static void main(String [] args){
    
    Scanner sc = new Scanner(System.in);
    
    System.out.println("Length and sum: ");
    
    int len =sc.nextInt(); int sum = sc.nextInt();
    
    int arr [] = new int[len];
    
    int first=0;
    int second=0;
    boolean found = false;
    
    for(int i =0; i<len; i++){
     arr[i]= sc.nextInt();
    }
    
    for(int i =0; i<len; i++){
      for(int j= i+1; j<len; j++){
        if(arr[i]+arr[j]==sum){
          first=i;
          second=j;
        found = true;
        break;
        }
        
      }
      if(found){
      break;
      }
    }
    
    if(found){
      System.out.println((first+1)+" "+(second+1));
    }
    else{
      System.out.println(-1);
    }
    
  }
}
